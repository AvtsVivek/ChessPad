<mah:MetroWindow x:Class="ChessPad.WpfUi.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChessPad.WpfUi"
        xmlns:views="clr-namespace:ChessPad.WpfUi.Views"
		xmlns:viewmodels="clr-namespace:ChessPad.ViewModels;assembly=ChessPad.ViewModels"
		mc:Ignorable="d"
		Title="ChessPad" Height="450" Width="800">
	<Window.Resources>
		<SolidColorBrush x:Key="WindowBackgroundBrush" Color="{x:Static views:BoardColors.WindowBackground}" />
		<SolidColorBrush x:Key="BoardFrameBrush" Color="{x:Static views:BoardColors.BoardFrame}" />
		<SolidColorBrush x:Key="LightSquareBrush" Color="{x:Static views:BoardColors.LightSquare}" />
		<SolidColorBrush x:Key="DarkSquareBrush" Color="{x:Static views:BoardColors.DarkSquare}" />
		<DataTemplate DataType="{x:Type viewmodels:RowColumnLabelViewModel}">
			<TextBlock Text="{Binding Label}" Foreground="{StaticResource LightSquareBrush}"
					   FontSize="16" FontWeight="SemiBold"
					   HorizontalAlignment="Center" VerticalAlignment="Center" />
		</DataTemplate>
		<ItemsPanelTemplate x:Key="RowLabelPanel">
			<UniformGrid Rows="8" Columns="1" />
		</ItemsPanelTemplate>
		<ItemsPanelTemplate x:Key="ColumnLabelPanel">
			<UniformGrid Rows="1" Columns="8" />
		</ItemsPanelTemplate>
	</Window.Resources>
	<Grid Background="{StaticResource WindowBackgroundBrush}">
		<Viewbox Margin="10" Stretch="Uniform">
			<Border Width="448" Height="448" Padding="0" Background="{StaticResource BoardFrameBrush}"
					BorderBrush="{StaticResource BoardFrameBrush}" BorderThickness="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="24" />
						<RowDefinition Height="*" />
						<RowDefinition Height="24" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="24" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="24" />
					</Grid.ColumnDefinitions>
					<ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ChessBoard.ColumnLabels}"
								  ItemsPanel="{StaticResource ColumnLabelPanel}" />
					<ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ChessBoard.ColumnLabels}"
								  ItemsPanel="{StaticResource ColumnLabelPanel}" />
					<ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding ChessBoard.RowLabels}"
								  ItemsPanel="{StaticResource RowLabelPanel}" />
					<ItemsControl Grid.Row="1" Grid.Column="2" ItemsSource="{Binding ChessBoard.RowLabels}"
								  ItemsPanel="{StaticResource RowLabelPanel}" />
					<ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ChessBoard.Fields}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="8" Columns="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewmodels:FieldViewModel}">
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource DarkSquareBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLight}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource LightSquareBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Viewbox>
    </Grid>
</mah:MetroWindow>
