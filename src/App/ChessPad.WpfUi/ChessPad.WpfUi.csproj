<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Autofac" Version="9.3.4" />
		<PackageReference Include="MahApps.Metro" Version="2.4.11" />
		<PackageReference Include="MahApps.Metro.IconPacks" Version="6.2.1" />
		<PackageReference Include="NLog.Extensions.Logging" Version="6.2.2" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\ChessPad.ViewModels\ChessPad.ViewModels.csproj" />
		<InternalsVisibleTo Include="ChessPad.WpfUi.IntegrationTests" />
	</ItemGroup>
	<ItemGroup>
		<None Update="Views\MainWindowSettings.settings">
			<Generator>SettingsSingleFileGenerator</Generator>
			<LastGenOutput>MainWindowSettings.Designer.cs</LastGenOutput>
			<CustomToolNamespace>ChessPad.WpfUi.Views</CustomToolNamespace>
		</None>
		<Compile Update="Views\MainWindowSettings.Designer.cs">
			<AutoGen>True</AutoGen>
			<DesignTimeSharedInput>True</DesignTimeSharedInput>
			<DependentUpon>MainWindowSettings.settings</DependentUpon>
		</Compile>
	</ItemGroup>
</Project>
