<UserControl x:Class="ChessPad.WpfUi.Views.MovesPanelView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Border Padding="16" Background="{DynamicResource MahApps.Brushes.Control.Background}">
		<StackPanel>
			<TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
			<TextBlock Text="{Binding EmptyMessage}" Margin="0,12,0,0" TextWrapping="Wrap" />
		</StackPanel>
	</Border>
</UserControl>
