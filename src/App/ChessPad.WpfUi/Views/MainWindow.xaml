<mah:MetroWindow x:Class="ChessPad.WpfUi.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChessPad.WpfUi"
		xmlns:views="clr-namespace:ChessPad.WpfUi.Views"
		mc:Ignorable="d"
		ShowIconOnTitleBar="True"
		SaveWindowPosition="True"
		Title="ChessPad" Height="450" Width="800">
	<mah:MetroWindow.IconTemplate>
		<DataTemplate>
			<iconPacks:PackIconGameIcons Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
									   Margin="4" Foreground="{DynamicResource MahApps.Brushes.IdealForeground}"
									   Kind="ChessQueen" />
		</DataTemplate>
	</mah:MetroWindow.IconTemplate>
	<Window.CommandBindings>
		<CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="OnExitExecuted" />
	</Window.CommandBindings>
	<Window.Resources>
		<SolidColorBrush x:Key="WindowBackgroundBrush" Color="{x:Static views:BoardColors.WindowBackground}" />
		<SolidColorBrush x:Key="BoardFrameBrush" Color="{x:Static views:BoardColors.BoardFrame}" />
		<SolidColorBrush x:Key="LightSquareBrush" Color="{x:Static views:BoardColors.LightSquare}" />
	</Window.Resources>
	<Grid Background="{StaticResource WindowBackgroundBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Menu Grid.Row="0">
			<MenuItem Header="_Game Menu">
				<MenuItem Header="E_xit" Command="{x:Static ApplicationCommands.Close}"
						  CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type views:MainWindow}}}">
					<MenuItem.Icon>
						<iconPacks:PackIconMaterial Kind="Power" Width="16" Height="16" />
					</MenuItem.Icon>
				</MenuItem>
			</MenuItem>
		</Menu>
		<Grid Grid.Row="1">
		<Grid.ColumnDefinitions>
			<ColumnDefinition x:Name="ChessGameColumn" Width="*" />
			<ColumnDefinition Width="5" />
			<ColumnDefinition x:Name="SidePanelColumn" Width="*" />
		</Grid.ColumnDefinitions>
		<views:ChessBoardView Grid.Column="0" DataContext="{Binding ChessBoard}" />
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" DragCompleted="VerticalGridSplitter_DragCompleted" />
        <Border Grid.Column="2" Background="{StaticResource BoardFrameBrush}">
            <TextBlock Text="Game information" Foreground="{StaticResource LightSquareBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
        </Border>
        </Grid>
    </Grid>
</mah:MetroWindow>
