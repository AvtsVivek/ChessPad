<UserControl x:Class="ChessPad.WpfUi.Views.BoardColorsSettingsView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:views="clr-namespace:ChessPad.WpfUi.Views">
	<UserControl.Resources>
		<SolidColorBrush x:Key="WindowBackgroundBrush" Color="{x:Static views:BoardColors.WindowBackground}" />
		<SolidColorBrush x:Key="BoardFrameBrush" Color="{x:Static views:BoardColors.BoardFrame}" />
		<SolidColorBrush x:Key="LightSquareBrush" Color="{x:Static views:BoardColors.LightSquare}" />
		<SolidColorBrush x:Key="DarkSquareBrush" Color="{x:Static views:BoardColors.DarkSquare}" />
	</UserControl.Resources>
	<Border Padding="16" Background="{DynamicResource MahApps.Brushes.Control.Background}">
		<StackPanel>
			<TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
			<TextBlock Text="Current board palette" Margin="0,12,0,8" />
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="48" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="36" />
					<RowDefinition Height="36" />
					<RowDefinition Height="36" />
					<RowDefinition Height="36" />
				</Grid.RowDefinitions>
				<TextBlock Grid.Row="0" Text="Window background" VerticalAlignment="Center" />
				<Border Grid.Row="0" Grid.Column="1" Background="{StaticResource WindowBackgroundBrush}" BorderBrush="Gray" BorderThickness="1" />
				<TextBlock Grid.Row="1" Text="Board frame" VerticalAlignment="Center" />
				<Border Grid.Row="1" Grid.Column="1" Background="{StaticResource BoardFrameBrush}" BorderBrush="Gray" BorderThickness="1" />
				<TextBlock Grid.Row="2" Text="Light squares" VerticalAlignment="Center" />
				<Border Grid.Row="2" Grid.Column="1" Background="{StaticResource LightSquareBrush}" BorderBrush="Gray" BorderThickness="1" />
				<TextBlock Grid.Row="3" Text="Dark squares" VerticalAlignment="Center" />
				<Border Grid.Row="3" Grid.Column="1" Background="{StaticResource DarkSquareBrush}" BorderBrush="Gray" BorderThickness="1" />
			</Grid>
		</StackPanel>
	</Border>
</UserControl>
